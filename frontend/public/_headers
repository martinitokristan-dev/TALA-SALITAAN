# Cloudflare Pages response headers (Vite copies this file to dist/).
# index.html keeps the Pages default (always revalidated), so a new deploy is seen at once.

# Hashed JS/CSS/fonts: the file name changes with every change, so they never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# PWA: the service worker, its loader and the manifest are always re-checked, so a new
# version is found at once.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/registerSW.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
